# ── server ────────────────────────────────────────────────
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=StrandsBot
MC_AUTH=offline            # offline | microsoft
# MC_VERSION=1.21.4        # pin only if auto-detect misbehaves

# ── model ─────────────────────────────────────────────────
# STRANDS_MODEL_PROVIDER=bedrock   # bedrock (default, ships with the SDK) | openai | anthropic
# STRANDS_MODEL_ID=global.anthropic.claude-sonnet-5   # per provider: gpt-5.4 / claude-sonnet-4-6 defaults
AWS_REGION=us-west-2               # bedrock reads the standard AWS_* credentials
# openai / anthropic are peer packages — `npm install openai` or `npm install @anthropic-ai/sdk`
# (the bot tells you the exact line at boot if it is missing), then their own key:
# OPENAI_API_KEY=sk-...   (also drives voice, below)
# ANTHROPIC_API_KEY=sk-ant-...

# ── voice (optional — text works without any of these) ────
# OPENAI_API_KEY=sk-...    # Whisper push-to-talk + realtime calls (CLI + dashboard)
# VOICE_DISABLED=true      # no /voice rail on the dashboard even with a key
# VOICE_MODEL=gpt-realtime-2.1-mini
# VOICE_NAME=              # marin (default) | cedar | ash | … (voice_config lists them)
# VOICE_REPLIES=true       # speak CLI answers aloud
# SAY_VOICE=Samantha
# VOICE_HALF_DUPLEX=1      # speakerphone without echo cancellation (CLI call only —
                           # the phone path has OS echo cancellation and never needs it)

# ── web dashboard ─────────────────────────────────────────
# WEB_PORT=3008
# WEB_FRAME_MS=350         # video frame interval (~3fps)
# WEB_AUTH_DISABLED=true   # no passkey gate (LAN dev only)
# WEB_BOOTSTRAP_TOKEN=     # secret required for the FIRST passkey enrollment

# ── tiny.technology (the bot as a device) ─────────────────
# Service token for the tiny endpoint routes (/api/health is public; /api/telemetry,
# /api/camera/snapshot, /api/stream.mjpeg, /api/events, POST /api/chat, POST /api/stop
# take it as `Authorization: Bearer`, `?token=`, or the passkey cookie). ≥32 chars;
# without it every remote tiny caller gets 401. `openssl rand -hex 32`
# TINY_TOKEN=

# ── mind & eyes ───────────────────────────────────────────
# THINKER_INTERVAL_MS=90000

# Shared-history sliding window (messages kept after a fold; min 8)
# SESSION_WINDOW=120
# A throttle on a shared model quota is nobody's bug — the session retries once
# (resuming from history, never re-asking, so no double user message).
# THROTTLE_RETRY_MS=2000
# Audit the shared history for split toolUse/toolResult pairs after every fold
# and trim — turns an intermittent provider 4xx into a named local defect.
# HISTORY_AUDIT=true
# THINKER_DISABLED=true
# VIEWER_PORT=3007
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome

# ── reflexes ──────────────────────────────────────────────
# REFLEX_COOLDOWN_MS=15000 # min gap between pain reactions
# REFLEX_DISABLED=true     # pain/hunger don't wake the agent
# HUNGER_NOTE_AT=6         # food level that queues the eat-now note (re-arms at 14)

# ── the nervous system (sentinel senses + spinal-cord modes) ──
# Who may dig and open chests around your waypoints WITHOUT being reported as an
# intruder — you, and anyone building with the bot (comma-separated, case-
# insensitive). Without this, base security reports the operator (issue #9).
# TRUSTED_PLAYERS=YourName,Friend
# SECURITY_SETTLE_MS=4000  # how long one digging note waits to count blocks
# SECURITY_QUIET_MS=90000  # then silence per (digger, base) until one escalation
# SENTINEL_DISABLED=true   # no hearing/radar/clock/social/base-security notes
# REFLEX_MODES_DISABLED=true             # no 300ms survival tick at all
# REFLEX_MODES_OFF=item_magnet,idle_staring  # disable individual modes
# REFLEX_TICK_MS=300       # how often the spinal cord looks at the world
# NOTES_CAP=40             # notes waiting for the mind; sightings are evicted first
# RADAR_MIN_GAP_MS=3000    # per-mob floor between radar notes (escalation exempt)
# PEER_BOTS=Ivy,Kai        # crew names whose chat is logged, never answered
# MEMORY_DIR=~/.strands-minecraft   # waypoints + journey/fleet ledgers

# ── docker memory sizing (issue #13: heap < mem_limit < REAL VM memory) ──
# The bot prints a 🚨 line at boot when these don't hold. Check the VM with
# `docker info | grep -i memory` (colima/Docker Desktop default ≈4GB, which is
# NOT enough for server 2G + bot 3G — grow it, or lower BOTH of these).
# BOT_MEM_LIMIT=3g        # container ceiling
# BOT_HEAP_MB=2048        # V8 --max-old-space-size, keep ≈⅔ of BOT_MEM_LIMIT
# MC_MEMORY=2G            # bundled server's JVM heap
